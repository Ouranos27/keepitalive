# --- Redis (production). Omit both to run on the in-memory store. ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Polar (payments). Omit to run with the simulated checkout. ---
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
POLAR_WEBHOOK_SECRET=
# "sandbox" or "production"
POLAR_SERVER=production

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://keepitalive.lol
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=

# Launch instant (unix ms). Set once at deploy so the clock is deterministic
# across cold starts. If unset, the clock starts 24h from first read.
CLOCK_LAUNCH_AT=
